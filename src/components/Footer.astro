---
import { useTranslations, withBase, type Lang } from '../i18n/utils';
import { contactEmail, legalRoutes, localeRoute, primaryNav, routes } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const link = (path: string) => withBase(localeRoute(path, lang));

const nav = primaryNav
  .filter((item) => item.path !== routes.home)
  .map((item) => ({ href: link(item.path), label: t(item.key) }));
---

<footer class="bg-[var(--color-ink)] text-[var(--color-paper)]">
  <div class="mx-auto max-w-7xl px-6 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="font-display text-2xl mb-3">{t('site.title')}</div>
      <p class="text-sm text-[var(--color-paper)]/70 max-w-md leading-relaxed mb-6">
        {t('footer.description')}
      </p>
      <!--
        Réseaux sociaux : les comptes officiels sont attendus du Comité (#9).
        Aucun lien n'est publié tant qu'ils ne sont pas confirmés.
      -->
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest text-[var(--color-gold)] mb-4">{t('nav.label')}</div>
      <ul class="space-y-2 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:text-[var(--color-gold)] transition">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest text-[var(--color-gold)] mb-4">{t('nav.contact')}</div>
      <ul class="space-y-2 text-sm text-[var(--color-paper)]/70">
        <li>{t('contact.organisation')}</li>
        <li><a href={`mailto:${contactEmail}`} class="hover:text-[var(--color-gold)] transition">{contactEmail}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-[var(--color-paper)]/50">
      <div>© {year} {t('footer.copyright')}</div>
      <!--
        Les pages légales n'existent qu'en français pour l'instant : elles sont
        liées sans préfixe de langue plutôt que vers une adresse qui n'existe
        pas. Leur traduction relève du PRD 7.
      -->
      <div class="flex gap-6">
        <a href={withBase(legalRoutes.legal)} class="hover:text-[var(--color-paper)]">{t('footer.legal')}</a>
        <a href={withBase(legalRoutes.privacy)} class="hover:text-[var(--color-paper)]">{t('footer.privacy')}</a>
      </div>
    </div>
  </div>
</footer>
