---
import {
  contactEmail,
  languages,
  legalRoutes,
  localeRoute,
  primaryNav,
  routeFromPath,
  routes,
} from '../i18n/ui';
import { type Lang, useTranslations, withBase } from '../i18n/utils';

interface Props {
  /** The language the chrome is written in. */
  served: Lang;
  /** The language the visitor asked for — what the switcher marks as current. */
  requested: Lang;
}
const { served, requested } = Astro.props;
const t = useTranslations(served);
const year = new Date().getFullYear();

const link = (path: string, target: Lang = requested) => withBase(localeRoute(path, target));

// The same page in another language — see the header. The legal pages exist in
// French only until the Comité supplies translations.
const here = routeFromPath(Astro.url.pathname, withBase('/'));
const currentRoute = (Object.values(legalRoutes) as string[]).includes(here) ? routes.home : here;

const nav = primaryNav
  .filter((item) => item.path !== routes.home)
  .map((item) => ({ href: link(item.path), label: t(item.key) }));

const languageLinks = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code],
  href: link(currentRoute, code),
  current: code === requested,
}));
---

<footer class="on-dark bg-ink text-paper">
  <div class="mx-auto grid max-w-page gap-12 px-6 py-16 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="mb-3 font-display text-2xl">{t('site.title')}</p>
      <p class="mb-6 max-w-md text-sm leading-relaxed text-paper-deep">
        {t('footer.description')}
      </p>
      <!--
        Social media: the official accounts are owed by the Comité (#9). No link
        is published until they are confirmed.
      -->
    </div>

    <nav aria-label={t('nav.label')}>
      <h2 class="eyebrow mb-4 text-gold-light">{t('nav.label')}</h2>
      <ul class="space-y-2 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="transition hover:text-gold-light">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow mb-4 text-gold-light">{t('nav.contact')}</h2>
      <ul class="space-y-2 text-sm text-paper-deep">
        <li>{t('contact.organisation')}</li>
        <li>
          <a href={`mailto:${contactEmail}`} class="transition hover:text-gold-light">
            {contactEmail}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/20">
    <div class="mx-auto flex max-w-page flex-col items-center justify-between gap-3 px-6 py-6 text-xs text-paper-deep md:flex-row">
      <p>© {year} {t('footer.copyright')}</p>
      <!--
        The legal pages exist in French only for now, so they are linked without
        a language prefix rather than at an address that does not exist.
      -->
      <div class="flex flex-wrap items-center gap-6">
        <a href={withBase(legalRoutes.legal)} class="hover:text-white">{t('footer.legal')}</a>
        <a href={withBase(legalRoutes.privacy)} class="hover:text-white">{t('footer.privacy')}</a>
        <a href={withBase(legalRoutes.accessibility)} class="hover:text-white">
          {t('footer.accessibility')}
        </a>
        <nav class="flex items-center gap-3" aria-label={t('fallback.label')}>
          {languageLinks.map((item) => (
            <a
              href={item.href}
              hreflang={item.code}
              lang={item.code}
              aria-current={item.current ? 'true' : undefined}
              class:list={[
                'tracking-caps uppercase',
                item.current ? 'font-semibold text-white underline underline-offset-4' : 'hover:text-white',
              ]}
            >
              <span aria-hidden="true">{item.code}</span>
              <span class="sr-only">{item.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</footer>
