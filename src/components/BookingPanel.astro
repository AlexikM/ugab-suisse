---
/**
 * Whether an event is taking bookings, decided once, for the whole site.
 *
 * The assertion this component exists to protect is the one most likely to
 * embarrass the committee: **a full room must never show a working booking
 * button.** That went wrong easily before, because the decision was written out
 * three times — once in the event page's summary strip, once in its practical
 * information, once in the listing — and three copies of a rule drift.
 *
 * There are four answers and they are not the same answer:
 *
 * - `past` — the evening happened. Nothing to book, and the page's centre of
 *   gravity moves to the photographs.
 * - `sold-out` — the committee has marked the room full. No booking control and
 *   **no provider slot either**: with the flag set by hand there is nothing a
 *   widget could usefully say, and a widget that mounted anyway would be a
 *   second opinion about availability sitting next to the committee's own.
 * - `open` — an upcoming event with somewhere to book.
 * - `unavailable` — an upcoming event with no ticketing yet. The normal case for
 *   an announcement made as soon as the date and the venue are settled; it
 *   offers the committee's own address instead of a dead end.
 *
 * `past` wins over `sold-out`, which wins over having anywhere to book: a
 * sold-out evening that has already happened is simply past.
 *
 * **There is no fifth state for "open, with a widget".** `data-booking` answers
 * one question — can this visitor book? — and a shop identifier does not change
 * that answer, only how it is offered. How it is offered is already a fact about
 * the markup, `data-provider-state` on the slot, and two orthogonal questions are
 * better as two attributes than as a state whose name means "open, but".
 *
 * **The shop wins over the link when a fiche carries both.** They are two ways
 * to do one thing, and offering both is two buttons for one action; the widget
 * is the one that can report live availability, which is the entire reason PRD 6
 * embeds anything at all. A committee that wants the plain link removes the
 * identifier, which is the choice the two fields exist to give them.
 *
 * On the static-site problem: a prebuilt page cannot know a provider's remaining
 * stock, so this page never claims to — not a number of places left, and no
 * longer a room capacity either. PRD 6 removed that field: a figure the site
 * asserts and nothing verifies drifts the first time the room changes. What is
 * left is the honest sentence, and the provider's own availability widget in the
 * slot below, where the system that owns the stock reports it.
 */

import { localeRoute, routes } from '../i18n/ui';
import { type Lang, useTranslations, withBase } from '../i18n/utils';
import ProviderSlot from './ProviderSlot.astro';
import TicketingEmbed from './TicketingEmbed.astro';

export type BookingState = 'open' | 'sold-out' | 'past' | 'unavailable';

export function bookingState(event: {
  isPast: boolean;
  soldOut: boolean;
  ticketUrl: string | null | undefined;
  shopId?: string | null;
}): BookingState {
  if (event.isPast) return 'past';
  if (event.soldOut) return 'sold-out';
  return event.shopId || event.ticketUrl ? 'open' : 'unavailable';
}

interface Props {
  /** The language the page is written in. */
  served: Lang;
  /** The language the URL asked for — what internal links stay inside. */
  requested: Lang;
  isPast: boolean;
  soldOut: boolean;
  ticketUrl?: string | null;
  /** The provider's shop, when the committee has created the till. */
  shopId?: string | null;
  /**
   * `summary` is the one line in the event's facts strip; `full` is the section
   * lower down that a provider's widget mounts into. Same decision, two sizes.
   */
  variant: 'summary' | 'full';
}

const {
  served,
  requested,
  isPast,
  soldOut,
  ticketUrl = null,
  shopId = null,
  variant,
} = Astro.props;

const t = useTranslations(served);
const state = bookingState({ isPast, soldOut, ticketUrl, shopId });
const contactHref = withBase(localeRoute(routes.contact, requested));
---

{variant === 'summary' ? (
  <div data-booking={state}>
    {state === 'past' && <div class="text-lg leading-snug text-ink-muted">{t('event.finished')}</div>}

    {state === 'sold-out' && (
      <div class="text-lg leading-snug font-medium text-ink">{t('event.sold_out')}</div>
    )}

    {/*
      With a widget on the page, the strip points down to it rather than off the
      site: the booking is here, and sending the visitor to the provider's own
      page instead would throw away the reason for embedding it.
    */}
    {state === 'open' && shopId && (
      <a
        href="#billetterie"
        data-booking-control
        class="inline-block text-lg font-medium text-navy underline underline-offset-4 hover:text-red"
      >
        {t('event.book')} →
      </a>
    )}

    {state === 'open' && !shopId && ticketUrl && (
      <a
        href={ticketUrl}
        data-booking-control
        rel="noopener"
        class="inline-block text-lg font-medium text-navy underline underline-offset-4 hover:text-red"
      >
        {t('event.book')} →
      </a>
    )}

    {state === 'unavailable' && (
      <a
        href={contactHref}
        class="inline-block text-lg font-medium text-navy underline underline-offset-4 hover:text-red"
      >
        {t('event.ask')} →
      </a>
    )}
  </div>
) : (
  <div data-booking={state}>
    {/*
      A full room gets no provider slot at all — see the note at the top. It
      gets a statement, and a way to ask about a place that frees up, which is
      the only thing left that can actually help the visitor.
    */}
    {state === 'sold-out' && (
      <div class="border-l-4 border-ink bg-paper-soft p-6 sm:p-8">
        <p class="font-display text-2xl text-ink">{t('event.sold_out')}</p>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{t('event.sold_out_detail')}</p>
        <p class="mt-4 text-sm leading-relaxed text-ink-muted">{t('event.sold_out_contact')}</p>
        <a
          href={contactHref}
          class="eyebrow mt-6 inline-flex items-center border-b border-navy pb-1 text-navy hover:text-red"
        >
          {t('event.ask')} →
        </a>
      </div>
    )}

    {state === 'open' && shopId && (
      <ProviderSlot provider="ticketing" title={t('event.tickets_title')} connected>
        <TicketingEmbed shop={shopId} title={t('event.embed_title')} />
        <p class="mt-5 text-sm leading-relaxed text-ink-muted">{t('event.booking_external')}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted">{t('event.booking_languages')}</p>
        {/*
          What a visitor gets when the frame above never loads — a blocker, a
          proxy, or the provider having a bad afternoon. Never conditional: a
          slot that shows nothing reads as a broken site rather than a blocked
          script.
        */}
        <p class="mt-4 text-sm leading-relaxed text-ink-muted">{t('event.embed_blocked')}</p>
        <a
          href={contactHref}
          class="eyebrow mt-4 inline-flex items-center border-b border-navy pb-1 text-navy hover:text-red"
        >
          {t('event.ask')} →
        </a>
      </ProviderSlot>
    )}

    {state === 'open' && !shopId && ticketUrl && (
      <ProviderSlot provider="ticketing" title={t('event.tickets_title')}>
        <a
          href={ticketUrl}
          data-booking-control
          rel="noopener"
          class="eyebrow inline-flex items-center bg-red px-8 py-4 text-white transition hover:bg-red-deep"
        >
          {t('event.book')} →
        </a>
        <p class="mt-5 text-sm leading-relaxed text-ink-muted">{t('event.booking_external')}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted">{t('event.availability_note')}</p>
      </ProviderSlot>
    )}

    {state === 'unavailable' && (
      <ProviderSlot
        provider="ticketing"
        title={t('event.tickets_title')}
        pending={t('event.booking_pending')}
      >
        <a
          href={contactHref}
          class="eyebrow inline-flex items-center bg-red px-8 py-4 text-white transition hover:bg-red-deep"
        >
          {t('event.ask')} →
        </a>
      </ProviderSlot>
    )}

    {/*
      Nothing for a past event: the summary line already says it took place, and
      the photographs below are what the visitor came for.
    */}
  </div>
)}
