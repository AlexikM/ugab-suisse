---
/**
 * Renders a privacy notice only when there is something to give notice about.
 *
 * The prototype had a two-button consent dialogue whose own text claimed the site
 * used "cookies essentiels et, avec votre accord, des cookies de mesure
 * d'audience". None of that was true. The site sets nothing. So the dialogue
 * interrupted every visitor to collect consent for nothing — and wrote the
 * resulting non-consent to localStorage, which made it the only thing on the
 * entire site that stored anything at all.
 *
 * The fix is not a better banner. It is to have nothing that needs one: no
 * analytics, no cookies, no cross-site identifiers (see `analytics` and
 * `nonEssentialStorage` in src/i18n/legal.ts). With nothing to consent to, the
 * honest interface is no interface.
 *
 * This component stays rather than being deleted so the decision is enforced
 * instead of remembered. It is driven by the same declaration the privacy policy
 * renders: declare a non-essential storage user there and the notice comes back
 * on its own, on every page, without anyone having to think of it. Until then it
 * renders nothing — no markup, no script, no storage.
 *
 * If it ever does come back, it must become a real choice: a decline that is as
 * easy as an accept, nothing loaded before the visitor answers, and the answer
 * itself recorded in a way the privacy policy describes.
 */
import { legalLang, legalPages, nonEssentialStorage, storageNotice } from '../i18n/legal';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const locale = legalLang(lang);
const privacyTitle = legalPages[locale].privacy.title;
const declared = nonEssentialStorage.map((item) => item.name[locale]).join(', ');
---

{
  nonEssentialStorage.length > 0 && (
    <aside
      class="fixed bottom-0 inset-x-0 z-50 bg-ink text-white px-6 py-4"
      aria-label={privacyTitle}
    >
      <p class="mx-auto max-w-page text-sm leading-relaxed">{storageNotice[locale](declared)}</p>
    </aside>
  )
}
