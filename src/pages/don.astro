---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
const lang = 'fr';
const t = useTranslations(lang);
---

<Layout lang={lang} title="Faire un don">
  <section class="relative isolate bg-[var(--color-ink)] text-white overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img src={`${import.meta.env.BASE_URL}/images/humanitarian.jpg`} alt="" class="h-full w-full object-cover opacity-50" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-ink)] via-[var(--color-brand-deep)]/70 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-28 md:py-36">
      <div class="max-w-3xl">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6">Soutenir l'UGAB Suisse</div>
        <h1 class="font-display uppercase tracking-tight text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-8">{t('donate.title')}</h1>
        <p class="font-serif italic text-xl md:text-2xl text-white/85 leading-relaxed max-w-2xl">{t('donate.lead')}</p>
      </div>
    </div>
  </section>

  <!-- Impact chiffré -->
  <section class="bg-[var(--color-paper)] border-b border-[var(--color-line)] py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6 grid sm:grid-cols-3 gap-8 text-center">
      <div>
        <div class="font-display text-4xl md:text-5xl text-[var(--color-brand)] mb-2">643</div>
        <div class="text-xs uppercase tracking-widest text-[var(--color-ink-muted)]">donateurs en 2025</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl text-[var(--color-brand)] mb-2">200K CHF</div>
        <div class="text-xs uppercase tracking-widest text-[var(--color-ink-muted)]">reversés à l'Artsakh</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl text-[var(--color-brand)] mb-2">1'400</div>
        <div class="text-xs uppercase tracking-widest text-[var(--color-ink-muted)]">familles soutenues</div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-5xl px-6 grid md:grid-cols-2 gap-10">
      <!-- RaiseNow widget placeholder -->
      <div class="bg-[var(--color-paper)] border border-[var(--color-ink)]/10 p-10">
        <div class="text-xs uppercase tracking-widest text-[var(--color-brand)] mb-3">En ligne</div>
        <h2 class="text-2xl mb-4">{t('donate.twint')}</h2>
        <p class="text-sm text-[var(--color-ink-soft)] mb-6 leading-relaxed">
          Don ponctuel ou récurrent par Twint, carte bancaire ou virement direct. Reçu fiscal automatique.
        </p>

        <!--
          RaiseNow widget — à remplacer par le snippet officiel fourni par RaiseNow
          après création du compte UGAB Suisse. Documentation :
          https://docs.raisenow.com/
        -->
        <div id="raisenow-widget" class="min-h-[200px] bg-[var(--color-paper-soft)] grid place-items-center rounded-sm">
          <div class="text-center p-6">
            <div class="text-xs uppercase tracking-widest text-[var(--color-brand)] mb-3">Widget RaiseNow</div>
            <p class="text-sm text-[var(--color-ink-soft)]/70">À intégrer après création du compte RaiseNow</p>
          </div>
        </div>

        <p class="text-xs text-[var(--color-ink-soft)]/70 mt-4">{t('donate.tax')}</p>
      </div>

      <!-- Bank transfer / QR-bill -->
      <div class="bg-[var(--color-ink)] text-[var(--color-paper)] p-10">
        <div class="text-xs uppercase tracking-widest text-[var(--color-gold)] mb-3">Virement bancaire</div>
        <h2 class="text-2xl mb-4">{t('donate.qr_title')}</h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-[var(--color-gold)]/80 uppercase tracking-wider text-xs">Bénéficiaire</dt>
            <dd>UGAB Suisse</dd>
          </div>
          <div>
            <dt class="text-[var(--color-gold)]/80 uppercase tracking-wider text-xs">IBAN</dt>
            <dd class="font-mono">CH00 0000 0000 0000 0000 0</dd>
          </div>
          <div>
            <dt class="text-[var(--color-gold)]/80 uppercase tracking-wider text-xs">BIC</dt>
            <dd class="font-mono">XXXXXXXXXXX</dd>
          </div>
          <div>
            <dt class="text-[var(--color-gold)]/80 uppercase tracking-wider text-xs">Communication</dt>
            <dd>« Don 120 ans »</dd>
          </div>
        </dl>
        <p class="text-xs text-[var(--color-paper)]/60 mt-6 leading-relaxed">
          Pour un don avec QR-facture, contactez-nous à <a href="mailto:dons@ugab.ch" class="underline">dons@ugab.ch</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-paper-soft)] py-20 md:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h3 class="text-2xl mb-3">Legs et donations testamentaires</h3>
      <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
        L'UGAB Suisse est reconnue d'utilité publique. Vous pouvez inscrire l'association comme bénéficiaire dans votre testament. Pour toute question, contactez-nous en toute confidentialité.
      </p>
    </div>
  </section>
</Layout>
