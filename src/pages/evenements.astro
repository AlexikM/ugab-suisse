---
import { withBase } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'fr';
const events = (await getCollection('events', ({ data }) => !data.draft && data.lang === 'fr'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const now = Date.now();
const upcoming = events.filter((e) => e.data.date.valueOf() >= now);
const past = events.filter((e) => e.data.date.valueOf() < now).reverse();

const dateFmt = new Intl.DateTimeFormat('fr-CH', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
---

<Layout lang={lang} title="Événements">
  <section class="relative isolate bg-[var(--color-ink)] text-white overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img src={`${import.meta.env.BASE_URL}/images/concert.jpg`} alt="" class="h-full w-full object-cover opacity-40" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-ink)] via-[var(--color-ink)]/75 to-[var(--color-brand-deep)]/30"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-28 md:py-36">
      <div class="max-w-3xl">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6">Programme</div>
        <h1 class="font-display uppercase tracking-tight text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-8">Événements</h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl">Concerts, conférences, expositions, célébrations communautaires : l'UGAB Suisse vous donne rendez-vous tout au long de l'année.</p>
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-3xl mb-10">À venir</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
          {upcoming.map((ev) => (
            <a href={`${import.meta.env.BASE_URL}/evenements/${ev.id}`} class="group block">
              {ev.data.cover && (
                <div class="aspect-[4/3] mb-5 overflow-hidden bg-[var(--color-paper-soft)]">
                  <img src={withBase(ev.data.cover)} alt="" loading="lazy" class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" />
                </div>
              )}
              <div class="text-xs uppercase tracking-widest text-[var(--color-brand)] mb-2">{dateFmt.format(ev.data.date)}</div>
              <h3 class="text-2xl mb-2 group-hover:text-[var(--color-brand)] transition">{ev.data.title}</h3>
              <p class="text-sm text-[var(--color-ink-soft)]/80 mb-3">{ev.data.location}</p>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{ev.data.excerpt}</p>
              <span class="inline-flex items-center mt-4 text-xs font-display uppercase tracking-[0.18em] text-[var(--color-brand)] border-b border-[var(--color-brand)] pb-1">En savoir plus →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section class="bg-[var(--color-paper-soft)] py-20 md:py-24 md:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-3xl md:text-4xl mb-12">Événements passés</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
          {past.map((ev) => (
            <a href={`${import.meta.env.BASE_URL}/evenements/${ev.id}`} class="group block">
              {ev.data.cover && (
                <div class="aspect-[4/3] mb-5 overflow-hidden bg-[var(--color-paper-deep)]">
                  <img src={withBase(ev.data.cover)} alt="" loading="lazy" class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" />
                </div>
              )}
              <div class="text-xs uppercase tracking-widest text-[var(--color-ink-muted)] mb-2">{dateFmt.format(ev.data.date)}</div>
              <h3 class="text-2xl mb-2 group-hover:text-[var(--color-brand)] transition">{ev.data.title}</h3>
              <p class="text-sm text-[var(--color-ink-soft)]/80 mb-3">{ev.data.location}</p>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{ev.data.excerpt}</p>
              <span class="inline-flex items-center mt-4 text-xs font-display uppercase tracking-[0.18em] text-[var(--color-brand)] border-b border-[var(--color-brand)] pb-1">Voir l'événement →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
