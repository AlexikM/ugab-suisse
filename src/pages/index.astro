---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localizedPath, withBase } from '../i18n/utils';

const lang = 'fr';
const t = useTranslations(lang);

const now = Date.now();
const events = (await getCollection('events', ({ data }) => !data.draft && data.lang === 'fr'))
  .filter((e) => e.data.date.valueOf() >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout lang={lang}>
  <!-- HERO PLEINE LARGEUR avec image de fond -->
  <section class="relative isolate overflow-hidden bg-[var(--color-ink)] text-[var(--color-paper)] min-h-[88vh] flex items-end">
    <!--
      IMAGE DE FOND :
      Remplace l'URL Unsplash ci-dessous par /hero.jpg (à déposer dans /public).
      Idéalement : photo de la communauté UGAB Suisse, du Mont Ararat, d'un événement, ou des archives historiques.
    -->
    <div
      class="absolute inset-0 -z-10 bg-cover bg-center"
      style={`background-image: url('${import.meta.env.BASE_URL}/images/geneva.jpg');`}
      aria-hidden="true"
    ></div>

    <!-- Voile sombre dégradé bleu UGAB -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-[var(--color-ink)] via-[var(--color-brand-deep)]/80 to-[var(--color-brand)]/30"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-7xl px-6 py-24 md:py-32 w-full">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-3 text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-8 font-display">
          <span class="h-px w-10 bg-[var(--color-gold-light)]"></span>
          1906 — 2026
        </div>
        <h1 class="font-display uppercase text-5xl md:text-6xl lg:text-7xl leading-[1.02] tracking-tight mb-8 text-white [text-wrap:balance]">
          Créer des liens<br/>
          entre <span class="text-[var(--color-gold-light)]">la diaspora arménienne</span><br/>
          de Suisse.
        </h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl mb-12">
          Section suisse de l'Union Générale Arménienne de Bienfaisance, 120 ans au service du peuple arménien.
        </p>
        <div class="flex flex-wrap items-stretch gap-0">
          <a href={localizedPath('/don', lang)} class="inline-flex items-center bg-[var(--color-brand)] hover:bg-[var(--color-brand-deep)] px-8 py-4 text-sm font-display uppercase tracking-[0.18em] text-white transition">
            {t('hero.cta_donate')}
          </a>
          <a href={localizedPath('/a-propos', lang)} class="inline-flex items-center bg-[var(--color-brand-soft)] hover:bg-[#7a949a] px-8 py-4 text-sm font-display uppercase tracking-[0.18em] text-white transition">
            {t('hero.cta_learn')}
          </a>
        </div>
      </div>
    </div>

    <!-- Citation fondateur en bandeau bas (solid, no glassmorphism) -->
    <div class="absolute bottom-0 inset-x-0 bg-[var(--color-ink)]/85 border-t border-white/5">
      <div class="mx-auto max-w-7xl px-6 py-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-sm">
        <p class="font-serif italic text-white/80">
          « Servir le peuple arménien, partout dans le monde. »
        </p>
        <p class="text-xs uppercase tracking-widest text-[var(--color-gold-light)] font-display">
          Boghos Nubar Pacha — Fondateur, 1906
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-paper-soft)] py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-2xl mb-16">
        <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-4">Notre mission</div>
        <h2 class="text-4xl md:text-5xl text-[var(--color-ink)] leading-tight">
          Préserver l'identité, transmettre l'héritage.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-[var(--color-line)] border border-[var(--color-line)]">
        {[
          { num: '01', title: 'Culture', text: 'Concerts, expositions, conférences et publications pour faire rayonner la culture arménienne en Suisse.' },
          { num: '02', title: 'Éducation', text: 'Cours de langue arménienne, soutien à la jeunesse et programmes éducatifs pour transmettre aux nouvelles générations.' },
          { num: '03', title: 'Humanitaire', text: "Aide aux Arméniens d'Artsakh, d'Arménie et de la diaspora face aux crises humanitaires et sociales." },
        ].map((p) => (
          <article class="bg-[var(--color-paper)] p-10 md:p-14 flex flex-col min-h-[420px] group">
            <div class="flex items-start justify-between mb-10">
              <span class="font-display text-7xl md:text-8xl text-[var(--color-brand)] leading-none tracking-tight">{p.num}</span>
              <span class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold)] mt-3">Pilier</span>
            </div>
            <div class="h-px w-12 bg-[var(--color-gold)] mb-8 group-hover:w-24 transition-all duration-500"></div>
            <h3 class="text-3xl md:text-4xl mb-5 leading-tight text-[var(--color-ink)]">{p.title}</h3>
            <p class="text-base text-[var(--color-ink-soft)] leading-relaxed mt-auto">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {events.length > 0 && (
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex items-end justify-between mb-12">
          <div>
            <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-4">À venir</div>
            <h2 class="text-4xl md:text-5xl text-[var(--color-ink)]">Prochains événements</h2>
          </div>
          <a href={localizedPath('/evenements', lang)} class="hidden md:inline text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-brand)] underline underline-offset-4">
            Voir tous les événements →
          </a>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {events.map((ev) => (
            <a href={`${import.meta.env.BASE_URL}/evenements/${ev.id}`} class="group block">
              <div class="aspect-[4/3] mb-5 overflow-hidden bg-[var(--color-paper-soft)]">
                {ev.data.cover ? (
                  <img
                    src={withBase(ev.data.cover)}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                  />
                ) : (
                  <div class="h-full grid place-items-center text-[var(--color-brand)]/20 font-display text-6xl">☩</div>
                )}
              </div>
              <div class="text-xs uppercase tracking-widest text-[var(--color-brand)] mb-2">
                {dateFmt.format(ev.data.date)}
              </div>
              <h3 class="text-xl mb-2 text-[var(--color-ink)] group-hover:text-[var(--color-brand)] transition">
                {ev.data.title}
              </h3>
              <p class="text-sm text-[var(--color-ink-soft)] mb-3">{ev.data.location}</p>
              <p class="text-sm text-[var(--color-ink-soft)]/80 leading-relaxed">{ev.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- HIGHLIGHT — Retour en images du concert -->
  <section class="bg-[var(--color-paper-soft)] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 grid md:grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="md:col-span-7 aspect-[4/3] overflow-hidden bg-[var(--color-paper-deep)]">
        <img src={`${import.meta.env.BASE_URL}/images/recital.jpg`} alt="Concert UGAB Suisse à la Cathédrale Saint-Pierre, Genève" loading="lazy" class="h-full w-full object-cover" />
      </div>
      <div class="md:col-span-5">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-brand)] mb-4">Retour en images</div>
        <h2 class="text-3xl md:text-4xl leading-tight mb-6">Concert à la Cathédrale Saint-Pierre.</h2>
        <p class="font-serif italic text-lg text-[var(--color-ink-soft)] leading-relaxed mb-6">
          « Les 5 récitatifs de Shoujounian et le Requiem de Mozart ont fait résonner les pierres centenaires, écho discret de la résilience du peuple arménien à travers les siècles. »
        </p>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-8">
          Une soirée unique en partenariat avec le chef d'orchestre Luc Baghdassarian, suivie d'un dîner réunissant le comité UGAB Suisse, Sam Simonian (président UGAB Global) et son Conseil d'Administration.
        </p>
        <a href={localizedPath('/evenements', lang)} class="inline-flex items-center font-display text-xs uppercase tracking-[0.18em] text-[var(--color-brand)] hover:text-[var(--color-brand-deep)] transition border-b border-[var(--color-brand)] pb-1">
          Voir tous les événements →
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-ink)] text-[var(--color-paper)] py-28">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-gold)] mb-6">Depuis 1906</div>
      <p class="font-serif italic text-3xl md:text-4xl leading-[1.35] mb-10">
        « De Boghos Nubar Pacha à aujourd'hui, l'UGAB a traversé un siècle de bouleversements en gardant intacte sa mission&nbsp;: servir le peuple arménien, partout où il se trouve. »
      </p>
      <a href={localizedPath('/a-propos', lang)} class="inline-flex items-center gap-2 text-sm uppercase tracking-widest text-[var(--color-gold)] hover:text-[var(--color-paper)] transition">
        Lire notre histoire →
      </a>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-[var(--color-brand)] text-white py-24 md:py-32">
    <!-- Texture subtile : photo de fond très assombrie -->
    <div class="absolute inset-0 -z-10 opacity-15">
      <img src={`${import.meta.env.BASE_URL}/images/humanitarian.jpg`} alt="" class="h-full w-full object-cover" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-brand-deep)] via-[var(--color-brand)] to-[var(--color-brand-deep)]"></div>

    <div class="relative mx-auto max-w-7xl px-6 grid md:grid-cols-12 gap-12 items-end">
      <div class="md:col-span-7">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6">Soutenir l'UGAB Suisse</div>
        <h2 class="font-display uppercase tracking-tight text-4xl md:text-5xl lg:text-6xl text-white leading-[1.05] mb-6">
          Votre don nous permet d'agir,<br/>ici et là-bas.
        </h2>
        <p class="text-lg md:text-xl text-white/85 leading-relaxed max-w-xl">
          Dons défiscalisés en Suisse, paiement par Twint, carte ou virement. Reçu fiscal automatique.
        </p>
      </div>
      <div class="md:col-span-5 flex flex-col items-start md:items-end gap-6">
        <div class="grid grid-cols-2 gap-x-10 gap-y-4 w-full md:w-auto md:text-right">
          <div>
            <div class="font-display text-4xl text-white">643</div>
            <div class="text-xs uppercase tracking-widest text-[var(--color-gold-light)]/80 mt-1">donateurs 2025</div>
          </div>
          <div>
            <div class="font-display text-4xl text-white">200K</div>
            <div class="text-xs uppercase tracking-widest text-[var(--color-gold-light)]/80 mt-1">CHF reversés</div>
          </div>
        </div>
        <a href={localizedPath('/don', lang)} class="inline-flex items-center bg-white text-[var(--color-brand-deep)] hover:bg-[var(--color-gold-light)] hover:text-[var(--color-ink)] px-10 py-5 font-display uppercase tracking-[0.18em] text-sm transition whitespace-nowrap">
          {t('hero.cta_donate')} →
        </a>
      </div>
    </div>
  </section>
</Layout>
