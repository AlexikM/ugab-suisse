---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft && data.lang === 'fr');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const dateFmt = new Intl.DateTimeFormat('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' });
const timeFmt = new Intl.DateTimeFormat('fr-CH', { hour: '2-digit', minute: '2-digit' });
const isPast = event.data.date.valueOf() < Date.now();

const gallery = event.data.gallery && event.data.gallery.length > 0
  ? event.data.gallery
  : (event.data.cover ? [event.data.cover] : []);

const coords = event.data.coordinates;
const osmBbox = coords
  ? `${coords.lng - 0.008},${coords.lat - 0.004},${coords.lng + 0.008},${coords.lat + 0.004}`
  : null;
const osmEmbedUrl = coords
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${osmBbox}&layer=mapnik&marker=${coords.lat},${coords.lng}`
  : null;
const osmFullUrl = coords
  ? `https://www.openstreetmap.org/?mlat=${coords.lat}&mlon=${coords.lng}#map=17/${coords.lat}/${coords.lng}`
  : null;
const gMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.data.address ?? event.data.location)}`;

const allEvents = await getCollection('events', ({ data }) => !data.draft && data.lang === 'fr');
const otherEvents = allEvents
  .filter((e) => e.id !== event.id)
  .sort((a, b) => Math.abs(a.data.date.valueOf() - event.data.date.valueOf()) - Math.abs(b.data.date.valueOf() - event.data.date.valueOf()))
  .slice(0, 2);
---

<Layout lang="fr" title={event.data.title}>
  <!-- HERO -->
  <section class="relative isolate bg-[var(--color-ink)] text-white overflow-hidden">
    {event.data.cover && (
      <div class="absolute inset-0 -z-10">
        <img src={event.data.cover} alt="" class="h-full w-full object-cover opacity-50" />
      </div>
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[var(--color-ink)] via-[var(--color-ink)]/70 to-[var(--color-brand-deep)]/40"></div>

    <div class="relative mx-auto max-w-7xl px-6 py-28 md:py-40 min-h-[55vh] flex flex-col justify-end">
      <div class="max-w-4xl">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6 flex items-center gap-3 flex-wrap">
          <span>{isPast ? 'Événement passé' : 'Événement à venir'}</span>
          <span class="h-px w-8 bg-[var(--color-gold-light)]"></span>
          <span>{dateFmt.format(event.data.date)}</span>
        </div>
        <h1 class="font-display uppercase tracking-tight text-4xl md:text-6xl lg:text-7xl leading-[1.02] mb-8">
          {event.data.title}
        </h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-3xl">
          {event.data.excerpt}
        </p>
      </div>
    </div>
  </section>

  <!-- BARRE D'INFOS SOUS LE HERO -->
  <section class="bg-[var(--color-paper)] border-b border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-6 py-8 md:py-10 grid sm:grid-cols-2 md:grid-cols-4 gap-8 md:gap-10">
      <div>
        <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">Date</div>
        <div class="text-lg font-medium leading-snug">{dateFmt.format(event.data.date)}</div>
        <div class="text-sm text-[var(--color-ink-muted)] mt-1">{timeFmt.format(event.data.date)}{event.data.endDate ? ` — ${timeFmt.format(event.data.endDate)}` : ''}</div>
      </div>
      <div>
        <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">Lieu</div>
        <div class="text-lg font-medium leading-snug">{event.data.location}</div>
        {event.data.address && <div class="text-sm text-[var(--color-ink-muted)] mt-1">{event.data.address}</div>}
      </div>
      <div>
        <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">Organisateur</div>
        <div class="text-lg font-medium leading-snug">UGAB Suisse</div>
        <div class="text-sm text-[var(--color-ink-muted)] mt-1">120 ans en 2026</div>
      </div>
      <div>
        <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">{isPast ? 'Inscriptions' : 'Inscription'}</div>
        {event.data.registrationUrl ? (
          <a href={event.data.registrationUrl} class="inline-block text-lg font-medium text-[var(--color-brand)] underline underline-offset-4">S'inscrire →</a>
        ) : isPast ? (
          <div class="text-lg text-[var(--color-ink-muted)] leading-snug">Événement terminé</div>
        ) : (
          <a href="/contact" class="inline-block text-lg font-medium text-[var(--color-brand)] underline underline-offset-4">Nous contacter →</a>
        )}
      </div>
    </div>
  </section>

  <!-- DESCRIPTION / À PROPOS -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-4">À propos</div>
        <h2 class="text-3xl md:text-4xl leading-tight">{isPast ? 'L\'événement.' : 'Présentation.'}</h2>
        <div class="hidden lg:block mt-10 pt-6 border-t border-[var(--color-line)]">
          <div class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-ink-muted)] font-display mb-3">Partager</div>
          <div class="flex gap-3">
            <a href={`mailto:?subject=${encodeURIComponent(event.data.title)}&body=${encodeURIComponent(event.data.excerpt)}`} class="text-xs uppercase tracking-widest font-display text-[var(--color-ink)] hover:text-[var(--color-brand)] border-b border-[var(--color-line)] pb-1">Email</a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest font-display text-[var(--color-ink)] hover:text-[var(--color-brand)] border-b border-[var(--color-line)] pb-1">LinkedIn</a>
          </div>
        </div>
      </div>
      <div class="lg:col-span-8">
        <div class="prose prose-stone text-lg leading-[1.75] text-[var(--color-ink-soft)] max-w-none space-y-6 [&_strong]:text-[var(--color-ink)] [&_strong]:font-semibold [&_p:first-child]:text-2xl [&_p:first-child]:leading-[1.5] [&_p:first-child]:text-[var(--color-ink)] [&_p:first-child]:mb-8">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <!-- GALERIE / PORTFOLIO -->
  {gallery.length > 1 && (
    <section class="bg-[var(--color-paper-soft)] py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex items-end justify-between gap-6 mb-10 md:mb-14">
          <div>
            <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-3">Galerie</div>
            <h2 class="text-3xl md:text-5xl leading-tight">{isPast ? 'Retour en images.' : 'Aperçu visuel.'}</h2>
          </div>
          <div class="hidden md:block font-display text-xs uppercase tracking-[0.2em] text-[var(--color-ink-muted)] shrink-0">
            {String(gallery.length).padStart(2, '0')} photographies
          </div>
        </div>

        <!-- 1 photo hero pleine largeur -->
        <figure class="aspect-[16/9] md:aspect-[21/9] overflow-hidden bg-[var(--color-paper-deep)] mb-3 md:mb-4">
          <img src={gallery[0]} alt={`${event.data.title} — 01`} loading="lazy" class="h-full w-full object-cover" />
        </figure>

        <!-- Grille uniforme 3 colonnes pour le reste -->
        {gallery.length > 1 && (
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {gallery.slice(1).map((src, i) => (
              <figure class="aspect-[4/3] overflow-hidden bg-[var(--color-paper-deep)]">
                <img src={src} alt={`${event.data.title} — ${i + 2}`} loading="lazy" class="h-full w-full object-cover" />
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- INFOS PRATIQUES (carte + adresse) -->
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12">
        <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-3">Infos pratiques</div>
        <h2 class="text-3xl md:text-4xl leading-tight">Comment s'y rendre.</h2>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
        <div class="lg:col-span-4 order-2 lg:order-1">
          <div class="space-y-8">
            <div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">Adresse</div>
              <div class="text-lg font-medium leading-snug mb-1">{event.data.location}</div>
              {event.data.address && <div class="text-sm text-[var(--color-ink-muted)]">{event.data.address}</div>}
              <a href={gMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 text-sm text-[var(--color-brand)] hover:text-[var(--color-brand-deep)] underline underline-offset-4">
                Itinéraire Google Maps
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2h6v6M10 2L2 10"/></svg>
              </a>
            </div>

            <div class="pt-8 border-t border-[var(--color-line)]">
              <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">Horaire</div>
              <div class="text-lg font-medium leading-snug">{dateFmt.format(event.data.date)}</div>
              <div class="text-sm text-[var(--color-ink-muted)] mt-1">
                {timeFmt.format(event.data.date)}{event.data.endDate ? ` — ${timeFmt.format(event.data.endDate)}` : ''}
              </div>
            </div>

            {!isPast && (
              <div class="pt-8 border-t border-[var(--color-line)]">
                <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">Participer</div>
                {event.data.registrationUrl ? (
                  <a href={event.data.registrationUrl} class="inline-flex items-center bg-[var(--color-brand)] hover:bg-[var(--color-brand-deep)] mt-2 px-6 py-3 text-xs font-display uppercase tracking-[0.18em] text-white transition">
                    S'inscrire →
                  </a>
                ) : (
                  <a href="/contact" class="inline-flex items-center bg-[var(--color-brand)] hover:bg-[var(--color-brand-deep)] mt-2 px-6 py-3 text-xs font-display uppercase tracking-[0.18em] text-white transition">
                    Nous contacter →
                  </a>
                )}
              </div>
            )}
          </div>
        </div>

        <div class="lg:col-span-8 order-1 lg:order-2">
          <div class="aspect-[4/3] lg:aspect-[16/10] border border-[var(--color-line)] overflow-hidden bg-[var(--color-paper-soft)]">
            {osmEmbedUrl ? (
              <iframe
                src={osmEmbedUrl}
                title={`Carte — ${event.data.location}`}
                loading="lazy"
                class="w-full h-full"
                style="border:0"
              ></iframe>
            ) : (
              <div class="h-full grid place-items-center text-center p-8">
                <div>
                  <div class="font-display text-sm uppercase tracking-widest text-[var(--color-ink-muted)] mb-3">Lieu</div>
                  <div class="text-xl">{event.data.location}</div>
                  <a href={gMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm text-[var(--color-brand)] underline">Voir sur Google Maps →</a>
                </div>
              </div>
            )}
          </div>
          {osmFullUrl && (
            <div class="mt-3 text-right">
              <a href={osmFullUrl} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-[var(--color-ink-muted)] font-display hover:text-[var(--color-brand)]">
                Ouvrir en plein écran ↗
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- APPEL AU SPONSORING — layout centré, alignement net -->
  <section class="bg-[var(--color-ink)] text-white py-24 md:py-32">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6">Devenir partenaire</div>
      <h2 class="font-display uppercase tracking-tight text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-white mb-8 [text-wrap:balance]">
        Associez votre marque à 120 ans de culture arménienne.
      </h2>
      <p class="text-lg md:text-xl text-white/85 leading-relaxed mb-12 max-w-3xl mx-auto">
        En soutenant cet événement, votre entreprise s'associe à la plus ancienne organisation arménienne au monde — une visibilité auprès d'un public qualifié et le geste fort d'une marque qui défend la mémoire et la solidarité.
      </p>
    </div>

    <!-- Métriques en ligne horizontale, alignées -->
    <div class="mx-auto max-w-6xl px-6 mt-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10 border-y border-white/10">
        <div class="bg-[var(--color-ink)] p-8 text-center">
          <div class="font-display text-4xl md:text-5xl text-white mb-2">300+</div>
          <div class="text-[11px] uppercase tracking-widest text-[var(--color-gold-light)]/80">participants & VIP</div>
        </div>
        <div class="bg-[var(--color-ink)] p-8 text-center">
          <div class="font-display text-4xl md:text-5xl text-white mb-2">8 000</div>
          <div class="text-[11px] uppercase tracking-widest text-[var(--color-gold-light)]/80">vues réseaux</div>
        </div>
        <div class="bg-[var(--color-ink)] p-8 text-center">
          <div class="font-display text-4xl md:text-5xl text-white mb-2 whitespace-nowrap">3 pays</div>
          <div class="text-[11px] uppercase tracking-widest text-[var(--color-gold-light)]/80">CH · FR · AM</div>
        </div>
        <div class="bg-[var(--color-ink)] p-8 text-center">
          <div class="font-display text-4xl md:text-5xl text-white mb-2">120</div>
          <div class="text-[11px] uppercase tracking-widest text-[var(--color-gold-light)]/80">ans d'engagement</div>
        </div>
      </div>
    </div>

    <!-- CTA centré -->
    <div class="text-center mt-12">
      <p class="text-sm text-white/60 mb-6 max-w-xl mx-auto">
        Des formules sur-mesure et un dossier de partenariat détaillé sont disponibles sur simple demande.
      </p>
      <a href="/contact" class="inline-flex items-center bg-[var(--color-brand)] hover:bg-[var(--color-brand-deep)] px-10 py-5 text-sm font-display uppercase tracking-[0.18em] text-white transition">
        Demander le dossier →
      </a>
    </div>
  </section>

  <!-- AUTRES ÉVÉNEMENTS -->
  {otherEvents.length > 0 && (
    <section class="bg-[var(--color-paper-soft)] py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-4">D'autres événements</div>
        <h2 class="text-3xl md:text-4xl mb-12">Découvrir nos rendez-vous.</h2>
        <div class="grid md:grid-cols-2 gap-10">
          {otherEvents.map((e) => (
            <a href={`/evenements/${e.id}`} class="group grid grid-cols-12 gap-5">
              {e.data.cover && (
                <div class="col-span-5 aspect-[4/3] overflow-hidden bg-[var(--color-paper-deep)]">
                  <img src={e.data.cover} alt="" loading="lazy" class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" />
                </div>
              )}
              <div class="col-span-7 flex flex-col justify-center">
                <div class="text-xs uppercase tracking-widest text-[var(--color-brand)] mb-2">{dateFmt.format(e.data.date)}</div>
                <h3 class="text-xl mb-2 group-hover:text-[var(--color-brand)] transition">{e.data.title}</h3>
                <p class="text-sm text-[var(--color-ink-soft)]/80">{e.data.location}</p>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-12">
          <a href="/evenements" class="inline-flex items-center font-display text-xs uppercase tracking-[0.18em] text-[var(--color-brand)] hover:text-[var(--color-brand-deep)] border-b border-[var(--color-brand)] pb-1">
            ← Tous les événements
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
</style>
