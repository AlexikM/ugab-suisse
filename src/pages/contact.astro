---
import Layout from '../layouts/Layout.astro';
const lang = 'fr';
---

<Layout lang={lang} title="Contact">
  <!-- HERO -->
  <section class="bg-[var(--color-ink)] text-white">
    <div class="mx-auto max-w-7xl px-6 py-28 md:py-36">
      <div class="max-w-3xl">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6">Contact</div>
        <h1 class="font-display uppercase tracking-tight text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-8">Écrivez-nous</h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl">
          Une question, une proposition de partenariat, ou l'envie de rejoindre nos activités&nbsp;? Nous vous répondrons sous 48&nbsp;heures.
        </p>
      </div>
    </div>
  </section>

  <!-- FORMULAIRE (centré, unique focus) -->
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-4">Formulaire</div>
      <h2 class="text-3xl md:text-4xl leading-tight mb-10">Envoyer un message.</h2>

      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-8">
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY" />
        <input type="hidden" name="subject" value="Nouveau message — site UGAB Suisse" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="grid md:grid-cols-2 gap-8">
          <label class="block">
            <span class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 block font-display">Prénom & nom</span>
            <input type="text" name="name" required class="w-full border-b border-[var(--color-ink)]/20 bg-transparent py-3 text-base focus:outline-none focus:border-[var(--color-brand)] transition" />
          </label>
          <label class="block">
            <span class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 block font-display">Email</span>
            <input type="email" name="email" required class="w-full border-b border-[var(--color-ink)]/20 bg-transparent py-3 text-base focus:outline-none focus:border-[var(--color-brand)] transition" />
          </label>
        </div>

        <label class="block">
          <span class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 block font-display">Sujet</span>
          <input type="text" name="topic" class="w-full border-b border-[var(--color-ink)]/20 bg-transparent py-3 text-base focus:outline-none focus:border-[var(--color-brand)] transition" />
        </label>

        <label class="block">
          <span class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 block font-display">Message</span>
          <textarea name="message" rows="6" required class="w-full border border-[var(--color-line)] bg-[var(--color-paper-soft)] p-4 text-base focus:outline-none focus:border-[var(--color-brand)] transition"></textarea>
        </label>

        <button type="submit" class="inline-flex items-center bg-[var(--color-brand)] hover:bg-[var(--color-brand-deep)] px-8 py-4 text-sm font-display uppercase tracking-[0.18em] text-white transition">
          Envoyer le message →
        </button>
      </form>
    </div>
  </section>

  <!-- ANTENNES (3 cards en ligne) -->
  <section class="bg-[var(--color-paper-soft)] py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="text-xs uppercase tracking-[0.2em] text-[var(--color-brand)] mb-4">Coordonnées</div>
      <h2 class="text-3xl md:text-4xl leading-tight mb-12">Nous joindre.</h2>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <div class="text-base text-[var(--color-ink-soft)]">Union Générale Arménienne de Bienfaisance — Comité Suisse, Genève</div>
        </div>
        <a href="mailto:contact@ugab.ch" class="text-xl md:text-2xl font-display text-[var(--color-ink)] hover:text-[var(--color-brand)] transition border-b border-[var(--color-line)] hover:border-[var(--color-brand)] pb-1">
          contact@ugab.ch
        </a>
      </div>
    </div>
  </section>
</Layout>
