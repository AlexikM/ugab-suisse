---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../i18n/utils';
import type { LegalLang } from '../i18n/legal';
import { committee, lastReviewed, legalChrome, legalPages, pendingLabel } from '../i18n/legal';

// These three routes are the French ones; the trilingual lane owns localised routes.
const lang: LegalLang = 'fr';
const page = legalPages[lang].legalNotice;
const chrome = legalChrome[lang];
---

<Layout lang="fr" title={page.title} description={page.lead}>
  <section class="bg-[var(--color-ink)] text-white">
    <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
      <div class="max-w-3xl">
        <div class="font-display text-xs uppercase tracking-[0.25em] text-[var(--color-gold-light)] mb-6">{page.eyebrow}</div>
        <h1 class="font-display uppercase tracking-tight text-4xl md:text-5xl lg:text-6xl leading-[1.05] mb-6">{page.title}</h1>
        <p class="text-lg text-white/80 leading-relaxed">{page.lead}</p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl space-y-12">
        <div>
          <h2 class="font-display uppercase tracking-wide text-xl md:text-2xl mb-4">Coordonnées</h2>
          <address class="not-italic text-base leading-relaxed text-[var(--color-ink-soft)] space-y-1">
            <div>{committee.legalName}</div>
            <div>
              {committee.postalAddress ?? (
                <span class="bg-[var(--color-paper-deep)] px-2 py-0.5 text-sm">Adresse postale — {pendingLabel[lang]}</span>
              )}
            </div>
            <div>{committee.city}</div>
            <div>
              {committee.email ? (
                <a href={`mailto:${committee.email}`} class="text-[var(--color-brand)] underline">{committee.email}</a>
              ) : (
                <span class="bg-[var(--color-paper-deep)] px-2 py-0.5 text-sm">Adresse e-mail — {pendingLabel[lang]}</span>
              )}
            </div>
            <div>
              {committee.phone ?? (
                <span class="bg-[var(--color-paper-deep)] px-2 py-0.5 text-sm">Téléphone — {pendingLabel[lang]}</span>
              )}
            </div>
            <div>
              {committee.registrationNumber ?? (
                <span class="bg-[var(--color-paper-deep)] px-2 py-0.5 text-sm">Numéro IDE — {pendingLabel[lang]}</span>
              )}
            </div>
          </address>
        </div>

        {page.sections.map((section) => (
          <div>
            <h2 class="font-display uppercase tracking-wide text-xl md:text-2xl mb-4">{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p class="text-base leading-relaxed text-[var(--color-ink-soft)] mb-4">{paragraph}</p>
            ))}
            {section.bullets && (
              <ul class="list-disc pl-6 space-y-2 text-base leading-relaxed text-[var(--color-ink-soft)]">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </div>
        ))}

        <div class="border-t border-[var(--color-line)] pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-[var(--color-ink-muted)]">
          <div>{chrome.lastReviewed} : <time datetime={lastReviewed}>{lastReviewed}</time></div>
          <div class="flex gap-5">
            <a href={withBase('/confidentialite')} class="underline hover:text-[var(--color-ink)]">{chrome.privacyLink}</a>
            <a href={withBase('/accessibilite')} class="underline hover:text-[var(--color-ink)]">{chrome.accessibilityLink}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
