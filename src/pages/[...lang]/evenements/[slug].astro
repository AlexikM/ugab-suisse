---
import BookingPanel from '../../../components/BookingPanel.astro';
import TicketTypes from '../../../components/TicketTypes.astro';
import { pageContext } from '../../../i18n/fallback';
import { formatLocale, languagePaths, localeRoute, routes } from '../../../i18n/ui';
import { type Lang, withBase } from '../../../i18n/utils';
import Layout from '../../../layouts/Layout.astro';
import { editorial } from '../../../lib/content';
import { eventSchema } from '../../../seo';

// One route per entry the site may show, in every language: an event has an
// address in every language and the French one never moves, because ticket
// links get printed on invitations. The chrome follows the language of the page;
// the event's own text is in whatever language it was written in, until PRD 4
// models one entry with a title per language.
//
// The id travels in the props rather than the entry itself, and the page asks
// for it again below. Props are the routing table; an event is content, and
// content is read through the one boundary, here as everywhere else.
export async function getStaticPaths() {
  const events = await editorial.events();
  return languagePaths().flatMap((locale) =>
    events.map((event) => ({
      params: { ...locale.params, slug: event.id },
      props: { ...locale.props, eventId: event.id },
    })),
  );
}

interface Props {
  lang: Lang;
  eventId: string;
}
const { lang, eventId } = Astro.props;
const { served, t } = pageContext(lang, 'event');
const link = (path: string) => withBase(localeRoute(path, lang));

const event = await editorial.event(eventId);
if (!event) {
  // Unreachable while the two calls agree, which is the point of saying so: the
  // route above was built from this id moments ago, so an event that cannot be
  // read back means the two disagree about what a visitor may see. Failing the
  // build is the only safe answer — the alternative is publishing a page the
  // site had decided to withhold.
  throw new Error(
    `The route /evenements/${eventId} was built, but no such event can be read back. ` +
      'src/lib/content.ts decides both; see getStaticPaths above.',
  );
}

const rendered = await event.body();
const Body = rendered?.Content;

const locale = formatLocale[served];
const dateFmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' });
const timeFmt = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit' });

/**
 * A past event is an archive entry, and the brief asks for photographs rather
 * than dead booking links. When the Comité has uploaded a gallery it is the
 * gallery; when it has only ever supplied the cover, the cover is the archive.
 * One photograph is worth more than an empty section.
 */
const photographs =
  event.gallery.length > 0 ? event.gallery : event.isPast && event.cover ? [event.cover] : [];

/**
 * A link, not a map.
 *
 * The prototype embedded an OpenStreetMap iframe, which loaded — and so handed
 * the visitor's IP address to the OpenStreetMap Foundation — the moment the
 * event page opened, before anyone had shown the slightest interest in a map.
 * The written address is right beside it, so nothing is lost by waiting for the
 * click: this leaves the page and reaches a third party only because the
 * visitor chose to go there.
 */
const directionsUrl = `https://www.openstreetmap.org/search?query=${encodeURIComponent(
  event.address ?? event.location,
)}`;
---

<Layout
  lang={lang}
  section="event"
  title={event.title}
  description={event.excerpt}
  schema={[eventSchema(event, served, Astro.site)]}
>
  <!-- HERO -->
  <section class="relative isolate bg-ink text-white overflow-hidden">
    {event.cover && (
      <div class="absolute inset-0 -z-10">
        <img src={withBase(event.cover)} alt="" class="h-full w-full object-cover opacity-50" />
      </div>
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-navy-deep/40"></div>

    <div class="relative mx-auto max-w-page px-6 py-section-lg min-h-[55vh] flex flex-col justify-end">
      <div class="max-w-4xl">
        <div class="eyebrow mb-6 flex flex-wrap items-center gap-3 text-gold-light">
          <span>{event.isPast ? t('event.past') : t('event.upcoming')}</span>
          <span class="h-px w-8 bg-gold-light" aria-hidden="true"></span>
          <span>{dateFmt.format(event.start)}</span>
          {event.soldOut && !event.isPast && (
            <span class="bg-white text-ink px-2 py-1 tracking-[0.18em]">{t('event.sold_out')}</span>
          )}
        </div>
        <h1 class="font-display text-display-xl mb-8">
          {event.title}
        </h1>
        <p class="text-lead max-w-3xl text-white">{event.excerpt}</p>
      </div>
    </div>
  </section>

  <!--
    L'ESSENTIEL — the facts strip.

    Tarifs and Nombre de places are separate cells. They used to share one, with
    the capacity printed under the "Tarifs" label, which read as though two
    hundred were part of the price. They answer different questions and the
    committee fills them in independently.
  -->
  <section class="bg-paper border-b border-line">
    <div class="mx-auto max-w-page px-6 py-8 md:py-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
      <div>
        <div class="eyebrow mb-2 text-navy">{t('event.date')}</div>
        <div class="text-lg font-medium leading-snug">{dateFmt.format(event.start)}</div>
        <div class="text-sm text-ink-muted mt-1">
          {timeFmt.format(event.start)}{event.end ? ` — ${timeFmt.format(event.end)}` : ''}
        </div>
      </div>

      <div>
        <div class="eyebrow mb-2 text-navy">{t('event.venue')}</div>
        <div class="text-lg font-medium leading-snug">{event.location}</div>
        {event.address && <div class="text-sm text-ink-muted mt-1">{event.address}</div>}
      </div>

      {event.pricing && (
        <div>
          <div class="eyebrow mb-2 text-navy">{t('event.pricing')}</div>
          <TicketTypes pricing={event.pricing} />
        </div>
      )}

      {event.capacity && (
        <div>
          <div class="eyebrow mb-2 text-navy">{t('event.capacity')}</div>
          <div class="text-lg font-medium leading-snug">
            {event.capacity} {t('event.places')}
          </div>
          <div class="text-sm text-ink-muted mt-1">{t('event.capacity_note')}</div>
        </div>
      )}

      <div>
        <!--
          Labelled "Billetterie", not "Réserver": the cell holds four possible
          answers and only one of them is an invitation to book. "Réserver /
          Complet" reads as a contradiction.
        -->
        <div class="eyebrow mb-2 text-navy">{t('event.tickets_title')}</div>
        <BookingPanel
          served={served}
          requested={lang}
          variant="summary"
          isPast={event.isPast}
          soldOut={event.soldOut}
          ticketUrl={event.ticketUrl}
        />
      </div>
    </div>
  </section>

  <!-- DESCRIPTION -->
  <section class="py-section-lg">
    <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-8 lg:col-start-5">
        <div class="text-lg leading-[1.75] text-ink-soft max-w-none space-y-6 [&_strong]:text-ink [&_strong]:font-semibold">
          {Body && <Body />}
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMME -->
  {event.programme.length > 0 && (
    <section class="bg-paper-soft py-section">
      <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-display-sm">{t('event.programme')}</h2>
        </div>
        <div class="lg:col-span-8 space-y-5 text-lg leading-[1.75] text-ink-soft">
          {event.programme.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>
  )}

  <!--
    BILLETTERIE — the price list and the slot a provider's booking widget mounts
    into. Absent entirely on a past event: an archive page has nothing to book.
  -->
  {!event.isPast && (
    <section class="py-section">
      <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-display-sm">{t('event.tickets_title')}</h2>
        </div>
        <div class="lg:col-span-8 space-y-8">
          {event.pricing && (
            <div>
              <div class="eyebrow mb-3 text-navy">{t('event.ticket_types')}</div>
              <TicketTypes pricing={event.pricing} class="space-y-2" />
              {/*
                PRD 6: large amounts go by invoice and transfer, not by card —
                a four-figure table costs the committee real money in card fees,
                and a corporate buyer wants an invoice anyway. The page's share
                of that decision is a route to a person, not a claim about how
                the committee invoices.
              */}
              <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-muted">
                {t('event.large_booking')}
                {' '}
                <a
                  href={link(routes.contact)}
                  class="text-navy underline underline-offset-4 hover:text-red"
                >
                  {t('event.ask')}
                </a>
              </p>
            </div>
          )}

          {event.capacity && (
            <p class="text-sm leading-relaxed text-ink-muted">
              {event.capacity} {t('event.places')} — {t('event.capacity_note')}
            </p>
          )}

          <BookingPanel
            served={served}
            requested={lang}
            variant="full"
            isPast={event.isPast}
            soldOut={event.soldOut}
            ticketUrl={event.ticketUrl}
          />
        </div>
      </div>
    </section>
  )}

  <!-- GALERIE -->
  {photographs.length > 0 && (
    <section class="bg-paper-soft py-section">
      <div class="mx-auto max-w-page px-6">
        <h2 class="text-display-sm mb-10">{t('event.gallery')}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
          {photographs.map((src, index) => (
            <figure class="aspect-[4/3] overflow-hidden bg-paper-deep">
              <img src={withBase(src)} alt={`${event.title} — ${index + 1}`} loading="lazy" class="h-full w-full object-cover" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- INFOS PRATIQUES -->
  <section class="py-section">
    <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-display-sm">{t('event.practical')}</h2>
      </div>
      <div class="lg:col-span-8 space-y-8">
        <div>
          <div class="eyebrow mb-2 text-navy">{t('event.venue')}</div>
          <div class="text-lg font-medium leading-snug">{event.location}</div>
          {event.address && <div class="text-sm text-ink-muted mt-1">{event.address}</div>}
          <a
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 text-sm text-navy underline underline-offset-4 hover:text-red"
          >
            {t('event.directions')}
            <span aria-hidden="true">↗</span>
            <span class="sr-only">{t('event.directions_new_tab')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-page px-6 py-12">
    <a href={link(routes.events)} class="eyebrow inline-flex items-center border-b border-navy pb-1 text-navy hover:text-red">
      ← {t('event.all')}
    </a>
  </div>
</Layout>
