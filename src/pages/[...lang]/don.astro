---
import { Image } from 'astro:assets';
// PLACEHOLDER photography — see docs/content/placeholder-inventory.md (#9).
import humanitarianImage from '../../assets/images/humanitarian.jpg';
import { pageContext } from '../../i18n/fallback';
import {
  inLang,
  languagePaths,
  localeRoute,
  routes,
  sponsorshipTiers,
  suggestedAmounts,
} from '../../i18n/ui';
import { type Lang, withBase } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = languagePaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { served, t } = pageContext(lang, 'donate');
const link = (path: string) => withBase(localeRoute(path, lang));
---

<Layout lang={lang} section="donate" title={t('nav.donate_page')} description={t('donate.lead')}>
  <!-- TITRE & ACCROCHE -->
  <section class="relative isolate bg-ink text-white overflow-hidden">
    <Image
      src={humanitarianImage}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-50"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-navy-deep/70 to-transparent"></div>
    <div class="relative mx-auto max-w-page px-6 py-section-lg">
      <div class="max-w-3xl">
        <h1 class="font-display text-display-xl mb-8">{t('donate.title')}</h1>
        <p class="font-display text-lead max-w-2xl text-white italic">{t('donate.lead')}</p>
      </div>
    </div>
  </section>

  <!-- TEXTE D'IMPACT -->
  <section class="py-section-lg">
    <div class="mx-auto max-w-3xl px-6 space-y-6 text-lg leading-[1.75] text-ink-soft">
      <p>{t('donate.impact_p1')}</p>
      <p>{t('donate.impact_p2')}</p>
    </div>
  </section>

  <!-- MONTANTS SUGGÉRÉS -->
  <section class="bg-paper-soft py-section">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-display-sm mb-10">{t('donate.amounts_title')}</h2>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="eyebrow py-4 pr-6 text-navy">{t('donate.amount_column')}</th>
            <th scope="col" class="eyebrow py-4 text-navy">{t('donate.impact_column')}</th>
          </tr>
        </thead>
        <tbody>
          {inLang(suggestedAmounts, served).map((row) => (
            <tr class="border-b border-line">
              <th scope="row" class="py-5 pr-6 text-lg font-display font-medium whitespace-nowrap align-top">{row.amount}</th>
              <td class="py-5 text-ink-soft align-top">{row.impact}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="mt-8 text-sm text-ink-soft">{t('donate.terms')}</p>

      <!--
        The online donation module — a Swiss provider carrying TWINT,
        PostFinance, card and QR-bill — is embedded by PRD 5. The account does
        not exist yet, and no promise of a receipt or of tax deductibility is
        shown until PRD 7 has verified them.
      -->
      <div class="mt-10 border border-line bg-paper p-8">
        <p class="text-sm text-ink-soft leading-relaxed">{t('donate.provider_pending')}</p>
        <a href={link(routes.contact)} class="eyebrow mt-6 inline-flex items-center border-b border-navy pb-1 text-navy">
          {t('nav.contact')} →
        </a>
      </div>
    </div>
  </section>

  <!-- SPONSORING -->
  <section id="sponsoring" class="py-section-lg">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-display text-display-md mb-10">
        {t('sponsor.title')}
      </h2>
      <div class="space-y-6 text-lg leading-[1.75] text-ink-soft max-w-3xl">
        <p>{t('sponsor.p1')}</p>
        <p>{t('sponsor.p2')}</p>
      </div>
    </div>
  </section>

  <!-- PACKAGES DE PARTENARIAT -->
  <section class="bg-ink text-paper py-section">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-display-sm mb-4">{t('sponsor.packages_title')}</h2>
      <p class="text-sm text-gold-light mb-10">⚠ {t('sponsor.packages_note')}</p>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-white/20">
            <th scope="col" class="eyebrow py-4 pr-6 text-gold-light">{t('sponsor.package_column')}</th>
            <th scope="col" class="eyebrow py-4 pr-6 text-gold-light">{t('sponsor.amount_column')}</th>
            <th scope="col" class="eyebrow py-4 text-gold-light">{t('sponsor.benefits_column')}</th>
          </tr>
        </thead>
        <tbody>
          {inLang(sponsorshipTiers, served).map((tier) => (
            <tr class="border-b border-white/10 align-top">
              <th scope="row" class="py-5 pr-6 text-lg font-display font-medium whitespace-nowrap">{tier.name}</th>
              <td class="py-5 pr-6 whitespace-nowrap text-paper">{tier.amount}</td>
              <td class="py-5 text-sm leading-relaxed text-paper-deep">{tier.benefits}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <a href={link(routes.contact)} class="eyebrow mt-12 inline-flex items-center bg-red px-8 py-4 text-white transition hover:bg-red-deep">
        {t('sponsor.cta')} →
      </a>
    </div>
  </section>
</Layout>
