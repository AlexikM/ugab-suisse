---
import { pageContext } from '../../i18n/fallback';
import { contactEmail, languagePaths, legalRoutes, localeRoute } from '../../i18n/ui';
import { type Lang, withBase } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = languagePaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = pageContext(lang, 'contact');
const link = (path: string) => withBase(localeRoute(path, lang));
---

<Layout lang={lang} section="contact" title={t('nav.contact')} description={t('contact.lead')}>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-page px-6 py-section-lg">
      <div class="max-w-3xl">
        <h1 class="font-display text-display-xl mb-8">{t('contact.title')}</h1>
        <p class="text-lead max-w-2xl text-white">{t('contact.lead')}</p>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-6">
      <!--
        The confirmation wording the Comité approved. It is revealed when a form
        handler sends the visitor back with ?message=envoye. The handler itself
        — endpoint, anti-spam, where the message goes — is PRD 1's work on
        Infomaniak; this is only the receiving half.
      -->
      <p
        id="contact-confirmation"
        role="status"
        hidden
        class="mb-10 border-l-4 border-navy bg-paper-soft px-6 py-5 text-lg text-ink"
      >
        {t('contact.confirmation')}
      </p>

      <h2 class="text-display-sm mb-10">{t('contact.details_title')}</h2>

      <dl class="space-y-6">
        <div>
          <dt class="eyebrow mb-2 text-navy">{t('site.title')}</dt>
          <dd class="text-lg">{t('contact.organisation')}</dd>
        </div>
        <div>
          <dt class="eyebrow mb-2 text-navy">{t('contact.form_email')}</dt>
          <dd class="text-lg">
            <a
              href={`mailto:${contactEmail}`}
              class="border-b border-line-strong pb-0.5 text-ink transition hover:border-red hover:text-red"
            >
              {contactEmail}
            </a>
          </dd>
        </div>
      </dl>

      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-muted">{t('contact.pending')}</p>
    </div>
  </section>

  <!--
    There is no form on this page, on purpose.

    The prototype's form posted the sender's name, address and message to
    api.web3forms.com — a third-party form service that ADR-0001 rules out so
    that message content stays in Switzerland — with `access_key` still set to
    the literal string YOUR_ACCESS_KEY, so nothing was ever delivered. A form
    that quietly discards what someone took the trouble to write is worse than
    no form: the visitor believes they have been in touch, and waits.

    The honest interim is an address that reaches a person and a plain statement
    that the form comes later. PRD 1 replaces this block with the Infomaniak
    mail handler and Cloudflare Turnstile; when it does, the note about what
    happens to a message belongs beside the send button rather than here.
  -->
  <section class="bg-paper-soft py-section">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-display-sm mb-6">{t('contact.form_title')}</h2>
      <div class="border-l-4 border-gold bg-paper p-8">
        <p class="text-lg leading-relaxed text-ink-soft">{t('contact.form_pending')}</p>
        <a
          href={`mailto:${contactEmail}`}
          class="eyebrow mt-6 inline-flex items-center bg-red px-8 py-4 text-white transition hover:bg-red-deep"
        >
          {contactEmail}
        </a>
        <!--
          What happens to the message, beside the thing that sends it.

          The privacy policy has said this since PRD 7 and nothing on this page
          pointed at it except a bare link with no sentence in front of it.
          Telling somebody afterwards what became of what they wrote is not
          telling them; this is the moment they can still decide.

          It moves with the send button. When PRD 1 replaces the mailto with the
          Infomaniak form, this block goes under the submit control and the
          wording stands — the mailbox, the host and the retention are the same
          either way.
        -->
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-ink-muted">
          {t('contact.before_sending')}
          {' '}
          {t('contact.before_sending_more')}
          {' '}
          <a
            href={link(legalRoutes.privacy)}
            class="text-navy underline underline-offset-4 hover:text-red"
          >
            {t('footer.privacy')}
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('message') !== 'envoye') return;
    const confirmation = document.getElementById('contact-confirmation');
    if (confirmation) confirmation.hidden = false;
  })();
</script>
