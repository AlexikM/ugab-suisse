---
import { pageContext } from '../../i18n/fallback';
import {
  committee,
  lastReviewed,
  legalChrome,
  legalLang,
  legalPages,
  pendingLabel,
} from '../../i18n/legal';
import { languagePaths, legalRoutes, localeRoute } from '../../i18n/ui';
import { type Lang, withBase } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = languagePaths;

interface Props {
  lang: Lang;
}
const { lang: requested } = Astro.props;
// See src/pages/[...lang]/confidentialite.astro: `served` is the chrome's
// language, `lang` is the legal text's, and they cannot disagree.
const { served } = pageContext(requested, 'legal');
const lang = legalLang(served);
const link = (path: string) => withBase(localeRoute(path, requested));

const page = legalPages[lang].accessibility;
const chrome = legalChrome[lang];
---

<Layout lang={requested} section="legal" title={page.title} description={page.lead}>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-page px-6 py-section-lg">
      <div class="max-w-3xl">
        <div class="eyebrow mb-6 text-gold-light">{page.eyebrow}</div>
        <h1 class="font-display text-display-lg mb-6">{page.title}</h1>
        <p class="text-lead text-white">{page.lead}</p>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-page px-6">
      <div class="max-w-3xl space-y-12">
        {page.sections.map((section) => (
          <div>
            <h2 class="font-display text-display-sm mb-4">{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p class="text-base leading-relaxed text-ink-soft mb-4">{paragraph}</p>
            ))}
            {section.bullets && (
              <ul class="list-disc pl-6 space-y-2 text-base leading-relaxed text-ink-soft">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </div>
        ))}

        <div>
          <h2 class="font-display text-display-sm mb-4">{chrome.contactHeading}</h2>
          <address class="not-italic text-base leading-relaxed text-ink-soft space-y-1">
            <div>{committee.legalName}</div>
            <div>
              {committee.email ? (
                <a href={`mailto:${committee.email}`} class="text-navy underline">{committee.email}</a>
              ) : (
                <span class="bg-paper-deep px-2 py-0.5 text-sm">{chrome.labelEmail} — {pendingLabel[lang]}</span>
              )}
            </div>
            <div>
              {committee.phone ?? (
                <span class="bg-paper-deep px-2 py-0.5 text-sm">{chrome.labelPhone} — {pendingLabel[lang]}</span>
              )}
            </div>
          </address>
        </div>

        <div class="border-t border-line pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-ink-muted">
          <div>{chrome.lastReviewed} : <time datetime={lastReviewed}>{lastReviewed}</time></div>
          <div class="flex gap-5">
            <a href={link(legalRoutes.privacy)} class="underline hover:text-ink">{chrome.privacyLink}</a>
            <a href={link(legalRoutes.legal)} class="underline hover:text-ink">{chrome.legalLink}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
