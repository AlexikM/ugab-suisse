---
import { Image } from 'astro:assets';
// PLACEHOLDER photography — see docs/content/placeholder-inventory.md (#9).
import concertImage from '../../assets/images/concert.jpg';
import EventCover from '../../components/EventCover.astro';
import { pageContext } from '../../i18n/fallback';
import { formatLocale, languagePaths, localeRoute, routes } from '../../i18n/ui';
import { type Lang, withBase } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import { editorial } from '../../lib/content';

export const getStaticPaths = languagePaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { served, t } = pageContext(lang, 'events');
const link = (path: string) => withBase(localeRoute(path, lang));

// See src/pages/[...lang]/index.astro: events are not filtered by locale.
// Soonest first for what is coming, most recent first for the archive — the
// order is src/lib/content.ts's decision, not this page's.
const upcoming = await editorial.upcomingEvents();
const past = await editorial.pastEvents();

const dateFmt = new Intl.DateTimeFormat(formatLocale[served], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<Layout lang={lang} section="events" title={t('events.title')} description={t('events.intro')}>
  <section class="relative isolate bg-ink text-white overflow-hidden">
    <Image
      src={concertImage}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/75 to-navy-deep/30"></div>
    <div class="relative mx-auto max-w-page px-6 py-section-lg">
      <div class="max-w-3xl">
        <h1 class="font-display text-display-xl mb-8">
          {t('events.title')}
        </h1>
        <p class="text-lead max-w-2xl text-white">{t('events.intro')}</p>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-page px-6">
      <h2 class="text-display-sm mb-10">{t('events.upcoming_title')}</h2>

      {upcoming.length === 0 ? (
        <p class="text-lg text-ink-soft max-w-2xl leading-relaxed">{t('events.empty')}</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
          {upcoming.map((event) => (
            <a href={link(`${routes.events}/${event.id}`)} class="group block">
              <EventCover cover={event.cover} class="mb-5" />
              <div class="eyebrow mb-2 text-navy">{dateFmt.format(event.start)}</div>
              <h3 class="text-2xl mb-2 group-hover:text-red transition">
                {event.title}
                {event.soldOut && (
                  <span class="eyebrow ml-3 bg-ink px-2 py-1 align-middle text-white">
                    {t('event.sold_out')}
                  </span>
                )}
              </h3>
              <p class="text-sm text-ink-soft mb-3">{event.location}</p>
              <p class="text-sm text-ink-soft leading-relaxed">{event.excerpt}</p>
              <span class="eyebrow mt-4 inline-flex items-center border-b border-navy pb-1 text-navy">
                {t('events.more')} →
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="bg-paper-soft py-section">
      <div class="mx-auto max-w-page px-6">
        <h2 class="text-display-sm mb-3">{t('events.past_title')}</h2>
        <p class="text-lg text-ink-soft mb-12">{t('events.past_intro')}</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
          {past.map((event) => (
            <a href={link(`${routes.events}/${event.id}`)} class="group block">
              <EventCover cover={event.cover} ground="bg-paper-deep" class="mb-5" />
              <div class="eyebrow mb-2 text-ink-muted">{dateFmt.format(event.start)}</div>
              <h3 class="text-2xl mb-2 group-hover:text-red transition">{event.title}</h3>
              <p class="text-sm text-ink-soft mb-3">{event.location}</p>
              <p class="text-sm text-ink-soft leading-relaxed">{event.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
