---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
// PLACEHOLDER photography — see docs/content/placeholder-inventory.md (#9).
import concertImage from '../../assets/images/concert.jpg';
import { useTranslations, withBase, type Lang } from '../../i18n/utils';
import { languagePaths } from '../../i18n/ui';

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// See src/pages/[...lang]/index.astro: events are not filtered by locale.
const events = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);

const now = Date.now();
const upcoming = events.filter((event) => event.data.date.valueOf() >= now);
const past = events.filter((event) => event.data.date.valueOf() < now).reverse();

const locale = lang === 'fr' ? 'fr-CH' : 'en-CH';
const dateFmt = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<Layout lang={lang} title={t('events.title')} description={t('events.intro')}>
  <section class="relative isolate bg-[var(--color-ink)] text-white overflow-hidden">
    <Image
      src={concertImage}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-ink)] via-[var(--color-ink)]/75 to-[var(--color-brand-deep)]/30"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-28 md:py-36">
      <div class="max-w-3xl">
        <h1 class="font-display uppercase tracking-tight text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-8">
          {t('events.title')}
        </h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl">{t('events.intro')}</p>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-3xl mb-10">{t('events.upcoming_title')}</h2>

      {upcoming.length === 0 ? (
        <p class="text-lg text-[var(--color-ink-soft)] max-w-2xl leading-relaxed">{t('events.empty')}</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
          {upcoming.map((event) => (
            <a href={withBase(`/evenements/${event.id}`)} class="group block">
              {event.data.cover && (
                <div class="aspect-[4/3] mb-5 overflow-hidden bg-[var(--color-paper-soft)]">
                  <img src={withBase(event.data.cover)} alt="" loading="lazy" class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" />
                </div>
              )}
              <div class="text-xs uppercase tracking-widest text-[var(--color-brand)] mb-2">{dateFmt.format(event.data.date)}</div>
              <h3 class="text-2xl mb-2 group-hover:text-[var(--color-brand)] transition">
                {event.data.title}
                {event.data.soldOut && (
                  <span class="ml-3 align-middle text-xs uppercase tracking-[0.18em] font-display text-white bg-[var(--color-ink)] px-2 py-1">
                    {t('event.sold_out')}
                  </span>
                )}
              </h3>
              <p class="text-sm text-[var(--color-ink-soft)]/80 mb-3">{event.data.location}</p>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{event.data.excerpt}</p>
              <span class="inline-flex items-center mt-4 text-xs font-display uppercase tracking-[0.18em] text-[var(--color-brand)] border-b border-[var(--color-brand)] pb-1">
                {t('events.more')} →
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="bg-[var(--color-paper-soft)] py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-3xl md:text-4xl mb-3">{t('events.past_title')}</h2>
        <p class="text-lg text-[var(--color-ink-soft)] mb-12">{t('events.past_intro')}</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
          {past.map((event) => (
            <a href={withBase(`/evenements/${event.id}`)} class="group block">
              {event.data.cover && (
                <div class="aspect-[4/3] mb-5 overflow-hidden bg-[var(--color-paper-deep)]">
                  <img src={withBase(event.data.cover)} alt="" loading="lazy" class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" />
                </div>
              )}
              <div class="text-xs uppercase tracking-widest text-[var(--color-ink-muted)] mb-2">{dateFmt.format(event.data.date)}</div>
              <h3 class="text-2xl mb-2 group-hover:text-[var(--color-brand)] transition">{event.data.title}</h3>
              <p class="text-sm text-[var(--color-ink-soft)]/80 mb-3">{event.data.location}</p>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{event.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
