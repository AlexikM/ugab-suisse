---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
// PLACEHOLDER photography — see docs/content/placeholder-inventory.md (#9).
import archiveImage from '../../assets/images/archive.jpg';
import { pageContext } from '../../i18n/fallback';
import {
  actionAreas,
  bureauRoles,
  defaultLang,
  inLang,
  languagePaths,
  values,
} from '../../i18n/ui';
import { type Lang, withBase } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = languagePaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { served, t } = pageContext(lang, 'about');

// Hierarchical order, as the brief presents it — never alphabetical.
const officers = (await getCollection('bureau')).sort(
  (a, b) => bureauRoles.indexOf(a.data.role) - bureauRoles.indexOf(b.data.role),
);

/** The biography in this language, or the one the Comité has written so far. */
const biography = (bio?: Partial<Record<Lang, string>>) =>
  bio?.[served] ?? bio?.[defaultLang] ?? '';

// The note about what is still missing disappears once nothing is.
const bureauIncomplete =
  officers.length < bureauRoles.length ||
  officers.some((officer) => !officer.data.portrait || !biography(officer.data.bio));

/** Stands in for a portrait the Comité has not supplied yet. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0] ?? '')
    .join('')
    .toUpperCase();
---

<Layout lang={lang} section="about" title={t('about.title')} description={t('about.intro')}>
  <!-- INTRODUCTION -->
  <section class="relative isolate bg-ink text-white overflow-hidden">
    <Image
      src={archiveImage}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/75 to-navy-deep/30"></div>
    <div class="relative mx-auto max-w-page px-6 py-section-lg">
      <div class="max-w-3xl">
        <h1 class="font-display text-display-xl mb-8">
          {t('about.title')}
        </h1>
        <p class="text-lead max-w-2xl text-white">{t('about.intro')}</p>
      </div>
    </div>
  </section>

  <!-- HISTOIRE DE L'UGAB -->
  <section class="py-section-lg">
    <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-display-sm">{t('about.history_title')}</h2>
      </div>
      <div class="lg:col-span-8 space-y-6 text-lg leading-[1.75] text-ink-soft">
        <p>{t('about.history_p1')}</p>
        <p>{t('about.history_p2')}</p>
        <p>{t('about.history_p3')}</p>
      </div>
    </div>
  </section>

  <!-- MISSION ET VALEURS -->
  <section class="bg-paper-soft py-section-lg">
    <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-display-sm">{t('about.mission_title')}</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="text-lg leading-[1.75] text-ink-soft mb-10">{t('about.mission_body')}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {inLang(values, served).map((value) => (
            <li class="eyebrow border-b border-gold pb-1 text-navy">
              {value}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- LE COMITÉ SUISSE -->
  <section class="py-section-lg">
    <div class="mx-auto max-w-page px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-display-sm">{t('about.committee_title')}</h2>
      </div>
      <div class="lg:col-span-8 space-y-6 text-lg leading-[1.75] text-ink-soft">
        <p>{t('about.committee_p1')}</p>
        <p>{t('about.committee_p2')}</p>
      </div>
    </div>
  </section>

  <!-- AXES D'ACTION -->
  <section class="bg-paper-soft py-section-lg">
    <div class="mx-auto max-w-page px-6">
      <h2 class="text-display-sm mb-12">{t('about.actions_title')}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line">
        {inLang(actionAreas, served).map((area) => (
          <article class="bg-paper p-8 md:p-10">
            <h3 class="text-2xl mb-4 text-ink">{area.title}</h3>
            <p class="text-sm text-ink-soft leading-relaxed">{area.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BUREAU DU COMITÉ -->
  <section class="py-section-lg">
    <div class="mx-auto max-w-page px-6">
      <h2 class="text-display-sm mb-12">{t('about.bureau_title')}</h2>

      {officers.length > 0 && (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
          {officers.map((officer) => (
            <article>
              <div class="aspect-[3/4] mb-5 overflow-hidden bg-paper-soft">
                {officer.data.portrait ? (
                  <img
                    src={withBase(officer.data.portrait)}
                    alt={officer.data.name}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="h-full grid place-items-center font-display text-5xl text-navy/40" aria-hidden="true">
                    {initials(officer.data.name)}
                  </div>
                )}
              </div>
              <div class="eyebrow mb-2 text-navy">
                {t(`bureau.${officer.data.role}`)}
              </div>
              <h3 class="text-xl mb-3 text-ink">{officer.data.name}</h3>
              {biography(officer.data.bio) && (
                <p class="text-sm text-ink-soft leading-relaxed">{biography(officer.data.bio)}</p>
              )}
            </article>
          ))}
        </div>
      )}

      {bureauIncomplete && (
        <p class="mt-10 text-sm text-ink-muted leading-relaxed max-w-2xl">
          {t('about.bureau_pending')}
        </p>
      )}
    </div>
  </section>
</Layout>
