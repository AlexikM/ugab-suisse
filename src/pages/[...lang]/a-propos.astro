---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
// PLACEHOLDER photography — see docs/content/placeholder-inventory.md (#9).
import archiveImage from '../../assets/images/archive.jpg';
import { useTranslations, withBase, type Lang } from '../../i18n/utils';
import { actionAreas, bureauRoles, defaultLang, languagePaths, values } from '../../i18n/ui';

export const getStaticPaths = languagePaths;

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Hierarchical order, as the brief presents it — never alphabetical.
const officers = (await getCollection('bureau')).sort(
  (a, b) => bureauRoles.indexOf(a.data.role) - bureauRoles.indexOf(b.data.role),
);

/** The biography in this language, or the one the Comité has written so far. */
const biography = (bio?: { fr?: string; en?: string }) =>
  bio?.[lang] ?? bio?.[defaultLang] ?? '';

// The note about what is still missing disappears once nothing is.
const bureauIncomplete =
  officers.length < bureauRoles.length ||
  officers.some((officer) => !officer.data.portrait || !biography(officer.data.bio));

/** Stands in for a portrait the Comité has not supplied yet. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0] ?? '')
    .join('')
    .toUpperCase();
---

<Layout lang={lang} title={t('about.title')} description={t('about.intro')}>
  <!-- INTRODUCTION -->
  <section class="relative isolate bg-[var(--color-ink)] text-white overflow-hidden">
    <Image
      src={archiveImage}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-ink)] via-[var(--color-ink)]/75 to-[var(--color-brand-deep)]/30"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-28 md:py-36">
      <div class="max-w-3xl">
        <h1 class="font-display uppercase tracking-tight text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-8">
          {t('about.title')}
        </h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl">{t('about.intro')}</p>
      </div>
    </div>
  </section>

  <!-- HISTOIRE DE L'UGAB -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-3xl md:text-4xl leading-tight">{t('about.history_title')}</h2>
      </div>
      <div class="lg:col-span-8 space-y-6 text-lg leading-[1.75] text-[var(--color-ink-soft)]">
        <p>{t('about.history_p1')}</p>
        <p>{t('about.history_p2')}</p>
        <p>{t('about.history_p3')}</p>
      </div>
    </div>
  </section>

  <!-- MISSION ET VALEURS -->
  <section class="bg-[var(--color-paper-soft)] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-3xl md:text-4xl leading-tight">{t('about.mission_title')}</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="text-lg leading-[1.75] text-[var(--color-ink-soft)] mb-10">{t('about.mission_body')}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {values[lang].map((value) => (
            <li class="font-display text-sm uppercase tracking-[0.18em] text-[var(--color-brand)] border-b border-[var(--color-gold)] pb-1">
              {value}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- LE COMITÉ SUISSE -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-3xl md:text-4xl leading-tight">{t('about.committee_title')}</h2>
      </div>
      <div class="lg:col-span-8 space-y-6 text-lg leading-[1.75] text-[var(--color-ink-soft)]">
        <p>{t('about.committee_p1')}</p>
        <p>{t('about.committee_p2')}</p>
      </div>
    </div>
  </section>

  <!-- AXES D'ACTION -->
  <section class="bg-[var(--color-paper-soft)] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-3xl md:text-4xl leading-tight mb-12">{t('about.actions_title')}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-line)] border border-[var(--color-line)]">
        {actionAreas[lang].map((area) => (
          <article class="bg-[var(--color-paper)] p-8 md:p-10">
            <h3 class="text-2xl mb-4 text-[var(--color-ink)]">{area.title}</h3>
            <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{area.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BUREAU DU COMITÉ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-3xl md:text-4xl leading-tight mb-12">{t('about.bureau_title')}</h2>

      {officers.length > 0 && (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
          {officers.map((officer) => (
            <article>
              <div class="aspect-[3/4] mb-5 overflow-hidden bg-[var(--color-paper-soft)]">
                {officer.data.portrait ? (
                  <img
                    src={withBase(officer.data.portrait)}
                    alt={officer.data.name}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="h-full grid place-items-center font-display text-5xl text-[var(--color-brand)]/25" aria-hidden="true">
                    {initials(officer.data.name)}
                  </div>
                )}
              </div>
              <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-brand)] mb-2 font-display">
                {t(`bureau.${officer.data.role}`)}
              </div>
              <h3 class="text-xl mb-3 text-[var(--color-ink)]">{officer.data.name}</h3>
              {biography(officer.data.bio) && (
                <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{biography(officer.data.bio)}</p>
              )}
            </article>
          ))}
        </div>
      )}

      {bureauIncomplete && (
        <p class="mt-10 text-sm text-[var(--color-ink-muted)] leading-relaxed max-w-2xl">
          {t('about.bureau_pending')}
        </p>
      )}
    </div>
  </section>
</Layout>
